    "@orpheus-aviary/skybridge-proto": "0.1.4",
    "drizzle-orm": "0.38.4",
    "expo": "57.0.13",
    "expo-audio": "57.0.3",
    "expo-build-properties": "57.0.11",
    "expo-constants": "57.0.11",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.12",
    "expo-file-system": "57.0.4",
    "expo-linking": "57.0.6",
    "expo-secure-store": "57.0.1",
    "expo-share-intent": "8.0.1",
    "expo-sharing": "~57.0.14",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "lucide-react-native": "1.33.0",
    "react": "19.2.4",
