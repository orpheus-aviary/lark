index 0000000000000000000000000000000000000000..d29d05f863ea59989fa9d497fe4cbd73d48287da
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/service/TrackNavigationPlayer.kt
@@ -0,0 +1,78 @@
+package expo.modules.audio.service
+
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+
+// lark patch (0.1.1 ⑬). Track navigation for a host that owns the queue.
+//
+// expo-audio's session player holds ONE media item — the queue lives in
+// JavaScript — so ExoPlayer reports no next and no previous, and a car stereo,
+// a headset button or a lock screen has nothing to offer. This wrapper says
+// the commands exist and turns them into an EVENT rather than a seek: the host
+// already knows what "next" means for its list, and it is the only thing that
+// does.
+//
+// 🔴 THE COMMAND SET AND `isCommandAvailable` BOTH HAVE TO BE OVERRIDDEN.
+// Media3 gives a controller the intersection of what the session declares and
+// what the PLAYER reports, and `ForwardingPlayer.isCommandAvailable` asks the
+// wrapped player rather than this class's `getAvailableCommands`. Override one
+// and not the other and the buttons stay dead with every log looking right.
+//
+// `hasNextMediaItem` / `hasPreviousMediaItem` are the other half: they are
+// what the legacy PlaybackState — which is what AVRCP actually sees — reads to
+// decide whether SKIP_TO_NEXT is enabled.
+//
+// The seek methods deliberately do NOT touch the wrapped player. There is
+// nothing there to seek to, and a `seekToNextMediaItem()` that quietly did
+// nothing is exactly the failure this exists to prevent.
+@UnstableApi
+internal class TrackNavigationPlayer(
+  player: Player,
+  private val hasNext: Boolean,
+  private val hasPrevious: Boolean,
+  private val onCommand: (String) -> Unit
+) : ForwardingPlayer(player) {
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon()
+    if (hasNext) {
+      commands.add(Player.COMMAND_SEEK_TO_NEXT).add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    }
+    if (hasPrevious) {
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS).add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    }
+    return commands.build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean = when (command) {
+    Player.COMMAND_SEEK_TO_NEXT, Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM -> hasNext
+    Player.COMMAND_SEEK_TO_PREVIOUS, Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM -> hasPrevious
+    else -> super.isCommandAvailable(command)
+  }
+
+  override fun hasNextMediaItem(): Boolean = hasNext
+
+  override fun hasPreviousMediaItem(): Boolean = hasPrevious
+
+  override fun seekToNext() = emit(hasNext, COMMAND_NEXT)
+
+  override fun seekToNextMediaItem() = emit(hasNext, COMMAND_NEXT)
+
+  override fun seekToPrevious() = emit(hasPrevious, COMMAND_PREVIOUS)
+
+  override fun seekToPreviousMediaItem() = emit(hasPrevious, COMMAND_PREVIOUS)
+
+  private fun emit(enabled: Boolean, command: String) {
+    if (enabled) {
+      onCommand(command)
+    }
+  }
+
+  companion object {
+    const val COMMAND_NEXT = "next"
+    const val COMMAND_PREVIOUS = "previous"
+
+    /** The event an `AudioPlayer` emits to JavaScript, with `{ command }`. */
+    const val EVENT_REMOTE_COMMAND = "remoteCommand"
+  }
+}
