{
  "name": "@lark/gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run --passWithNoTests",
    "build:deps": "pnpm -F @lark/shared build && pnpm -F @lark/core build && pnpm -F @lark/daemon build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:notices": "node ../../scripts/gen-notices.mjs $LARK_FFMPEG_MODE",
    "package": "pnpm build:deps && pnpm build:icons && pnpm build:notices && electron-vite build && electron-builder install-app-deps && electron-builder --mac --arm64 --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lark/core": "workspace:*",
    "@lark/daemon": "workspace:*",
    "@lark/shared": "workspace:*",
    "@tailwindcss/vite": "4.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.4"
  }
}
